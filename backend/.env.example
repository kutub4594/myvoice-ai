# MyVoice AI Backend Configuration
APP_NAME=MyVoice AI Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Active engine: indicf5 | mock | f5 | chatterbox | cpu_fallback
# Use 'indicf5' for real Bengali zero-shot voice cloning on GPU/CPU host.
# Use 'mock' strictly for offline API/UI integration testing without ML weights.
VOICE_ENGINE=mock

# Inference device: auto | cuda | cpu | mps
INFERENCE_DEVICE=auto

# IndicF5 settings
INDICF5_MODEL_ID=ai4bharat/IndicF5
ENABLE_AUTO_TRANSCRIBE=false
WHISPER_MODEL_SIZE=small
MAX_CHUNK_CHARS=160
MAX_CONCURRENT_JOBS=1
MODEL_CACHE_DIR=

# Optional Gradio UI mount at /gradio (useful for Hugging Face Spaces)
ENABLE_GRADIO=false

# Security, Authentication & Transport
# Single-owner API token (all callers using this shared token share ONE owner bucket).
# NEVER use MYVOICE_API_TOKEN for multiple independent users — use MYVOICE_OWNER_TOKENS instead.
MYVOICE_API_TOKEN=change-me-use-a-long-random-secret
# Required for multi-user deployments: distinct per-user tokens (alice:secretA,bob:secretB)
# so each user's remote datasets, embeddings, and checkpoints stay strictly isolated.
MYVOICE_OWNER_TOKENS=
# Keep false in production/remote setups; set true ONLY for localhost/emulator HTTP dev
ALLOW_LOCAL_HTTP_DEV=false
# Comma-separated IPs or CIDRs of trusted TLS reverse proxies allowed to set X-Forwarded-Proto
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Privacy & upload limits
MAX_REFERENCE_AUDIO_MB=15
MIN_REFERENCE_DURATION_SEC=1.5
MAX_REFERENCE_DURATION_SEC=30.0
MAX_TRAINING_DATASET_MB=250
MAX_TRAINING_DATASET_UNCOMPRESSED_MB=500
MAX_TRAINING_ZIP_ENTRIES=5000
MAX_TRAINING_FILE_MB=100
# Optional private storage path OUTSIDE the Git repository (defaults outside repo on Colab/Kaggle/home)
PRIVATE_TRAINING_STORAGE_DIR=
MAX_TEXT_LENGTH=2000
CROSSFADE_MS=60
INTER_SEGMENT_PAUSE_MS=110

# CORS origins (comma-separated, or * for local/dev)
ALLOWED_ORIGINS=*

# Optional Hugging Face token required for gated weights like ai4bharat/IndicF5
# Never commit real tokens or expose them in API responses.
HF_TOKEN=
