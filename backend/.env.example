# MyVoice AI Backend Configuration
APP_NAME=MyVoice AI Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Active engine: mock | f5 | chatterbox | cpu_fallback
# Use 'mock' for API/UI integration testing without downloading ML weights.
VOICE_ENGINE=mock

# Optional Gradio UI mount at /gradio (useful for Hugging Face Spaces)
ENABLE_GRADIO=false

# Privacy & upload limits
MAX_REFERENCE_AUDIO_MB=15
MAX_TEXT_LENGTH=1000
CROSSFADE_MS=60
INTER_SEGMENT_PAUSE_MS=110

# CORS origins (comma-separated, or * for local/dev)
ALLOWED_ORIGINS=*

# Optional Hugging Face token ONLY needed when downloading gated weights like ai4bharat/IndicF5
# Never commit real tokens.
HF_TOKEN=
